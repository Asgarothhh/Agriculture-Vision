# App
APP_ENV=dev
SECRET_KEY=change-me-in-production-use-a-long-random-string
ENCRYPTION_KEY=change-me-32-byte-aes-key-please!!
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://localhost:8000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agriculture-vision
POSTGRES_USER=developer
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://developer:CHANGE_ME@localhost:5432/agriculture-vision
DATABASE_SYNC_URL=postgresql://developer:CHANGE_ME@localhost:5432/agriculture-vision

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_QUEUE_CPU=cpu
CELERY_QUEUE_GPU=ml-gpu

# Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=agrovision
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# If MinIO is down, files are stored under this directory
# LOCAL_STORAGE_DIR=data/uploads

# Local ML weights (no separate ML server)
YOLO_WEIGHTS_PATH=config/yolo_best.pt
SEGFORMER_WEIGHTS_PATH=config/segformer_best.pt
MAX_UPLOAD_MB=512
MAX_SAVED_TASKS=50

# Email (восстановление пароля: код из 4 цифр, «Бек ошибки»)
# Пустой SMTP_HOST: письмо не отправляется. В APP_ENV=dev код вернётся в JSON (dev_code) и покажется в модалке.
# В APP_ENV=prod без SMTP запрос даст 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=noreply@agrovision.local

# dzz.by / geodzz.by ImageServer (без /tile/{z}/{y}/{x})
DZZ_DEFAULT_URL=https://www.dzz.by/arcgis/rest/services/georesursDDZ/Belarus_web_mercator_all/ImageServer
HF_HOME=.cache/huggingface
# After the Hugging Face cache is populated in the image/volume:
# HF_HUB_OFFLINE=1
